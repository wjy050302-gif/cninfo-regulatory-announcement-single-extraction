# Copy to .env and fill real secrets locally. Do NOT commit .env.
#
# Only put variable names and placeholders here. Never commit real keys.

# LLM (OpenAI-compatible chat completions)
LLM_PROVIDER=your_provider
LLM_BASE_URL=your_base_url
LLM_API_KEY=your_key_here
LLM_MODEL=your_model_here

# MinerU (Precision Extract API requires a token)
MINERU_API_KEY=your_key_here
# Optional override; defaults to https://mineru.net
MINERU_BASE_URL=https://mineru.net
